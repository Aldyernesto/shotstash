# Never in the image build context: dependencies are installed inside,
# build output is produced inside, and no .env ever reaches an image.
node_modules
.next
dist
.git
.github
.devdb
data
.env*
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
coverage
worker
# The docs site is a separate app (docs/package.json); only the design
# sources that the build checks (docs/design) reach the image build.
docs/*
!docs/design
# Launch texts (Story 8.3) are not part of any image.
launch
# The promo trailer (page, renderer, vendored three.js, videos) is not part of any image.
promo
