{
  "name": "shotstash",
  "version": "0.1.0",
  "description": "Self-hosted media cloud for creators. Your footage, your hardware, your cloud.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aldyernesto/shotstash.git"
  },
  "homepage": "https://github.com/Aldyernesto/shotstash#readme",
  "bugs": {
    "url": "https://github.com/Aldyernesto/shotstash/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "dev:db": "pglite-server --db=./.devdb/pgdata --port=55433 --max-connections=10",
    "dev:seed": "node -e \"if(process.env.NODE_ENV==='production'){console.error('Refusing to seed: NODE_ENV=production');process.exit(2)}\" && prisma migrate deploy && tsx prisma/seed.ts",
    "demo:seed": "tsx prisma/demo-seed.ts",
    "dev:seed:bulk": "tsx scripts/seed-bulk.ts",
    "dev:db:reset": "node -e \"require('fs').rmSync('.devdb/pgdata',{recursive:true,force:true})\"",
    "build": "node scripts/check-folder-shell.mjs && next build && npm run build:server",
    "build:server": "node scripts/build-server.mjs",
    "build:folder-shell": "node scripts/build-folder-shell-geometry.mjs",
    "check:folder-shell": "node scripts/check-folder-shell.mjs",
    "start": "NODE_ENV=production node dist/server.js",
    "lint": "eslint --max-warnings 283",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:legacy": "node scripts/check-legacy-allowlist.mjs",
    "brand:css": "tsx scripts/gen-brand-css.ts",
    "brand:assets": "node scripts/gen-brand-assets.mjs",
    "privacy:scan": "node scripts/privacy-scan.mjs",
    "privacy:hash": "node scripts/privacy-hash.mjs",
    "security:matrix": "tsx scripts/gen-route-matrix.ts",
    "e2e:security": "node scripts/e2e-security.mjs",
    "e2e:setup": "node scripts/e2e-setup.mjs",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/i18n-check.mjs",
    "env:example": "node scripts/gen-env-example.mjs",
    "env:example:check": "node scripts/gen-env-example.mjs --check",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "test:s3": "node --import tsx --test scripts/storage-s3.contract.mjs",
    "e2e:upload": "node scripts/e2e-upload-resume.mjs",
    "e2e:search": "tsx scripts/e2e-search-parity.ts",
    "search:reindex": "tsx scripts/search-reindex.ts",
    "thumbs:rebuild": "tsx scripts/thumbs-rebuild.ts",
    "zip64:check": "node scripts/zip64-check.mjs"
  },
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@apollo/server": "^5.5.0",
    "@as-integrations/next": "^4.1.0",
    "@aws-sdk/client-s3": "3.1142.0",
    "@aws-sdk/lib-storage": "3.1142.0",
    "@aws-sdk/s3-request-presigner": "3.1142.0",
    "@elastic/elasticsearch": "^9.3.4",
    "@graphql-tools/schema": "^10.0.33",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-email/components": "^1.0.12",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/pg": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "cookie": "^1.1.1",
    "dotenv": "^17.4.2",
    "google-auth-library": "^10.6.2",
    "graphql": "^16.13.2",
    "graphql-redis-subscriptions": "^2.7.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-tag": "^2.12.6",
    "graphql-ws": "^6.0.8",
    "hash-wasm": "4.12.0",
    "heic-convert": "^2.1.0",
    "image-size": "^2.0.2",
    "ioredis": "^5.10.1",
    "nanoid": "^5.1.11",
    "next": "16.2.4",
    "next-intl": "4.14.7",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "uuid": "^14.0.0",
    "ws": "^8.20.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.1",
    "@electric-sql/pglite-socket": "^0.1.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@types/yazl": "^3.3.1",
    "draco3d": "^1.5.7",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "eslint-plugin-i18next": "6.1.5",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
