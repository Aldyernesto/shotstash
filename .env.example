# Shotstash environment. Copy this file to .env for local development.
# Every value here is a placeholder; nothing in this file is a real secret.

# PostgreSQL connection string.
# Local development: `npm run dev:db` starts an embedded PGlite server on port 55433.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55433/postgres?sslmode=disable"

# Random secret used to sign sessions and reset tokens. REQUIRED: at least 32
# characters, generated with:
#   openssl rand -hex 32
# The server refuses to start while this placeholder (or a short value) is the
# effective signing secret.
SESSION_SECRET=change-me-before-first-run

# Secret for signed share media URLs, share access cookies and access codes.
# Falls back to SESSION_SECRET when empty. REQUIRED (one of the two): at least
# 32 characters, generated with:
#   openssl rand -hex 32
MEDIA_SIGNING_SECRET=

# Set to true ONLY when the app is reachable exclusively through a reverse proxy
# (Cloudflare, nginx) that sets cf-connecting-ip / x-forwarded-for /
# x-forwarded-proto. Otherwise clients could spoof those headers, so the app
# uses the TCP peer address and the request URL scheme.
TRUST_PROXY=

# Root directory for originals, thumbnails and temporary uploads.
# Any local path works, including a mounted NAS share.
STORAGE_LOCAL_ROOT=./data/media

# Dragonfly (or Redis) for realtime pub/sub.
DRAGONFLY_HOST=127.0.0.1
DRAGONFLY_PORT=6379
DRAGONFLY_PASSWORD=

# Port of the custom Next.js server.
PORT=3005

# Public URL of this installation, used in emails and share links.
NEXT_PUBLIC_APP_URL=http://localhost:3005

# Optional. Elasticsearch accelerates search; leave empty to search in PostgreSQL only.
ELASTICSEARCH_NODE_URL=

# Optional. Email for password reset.
#   RESEND_API_KEY set      -> messages go out through Resend
#   EMAIL_TRANSPORT=log     -> nothing is sent; the last message is kept in memory (dev/test)
#   both empty              -> the password reset feature stays hidden
EMAIL_TRANSPORT=
EMAIL_FROM="Shotstash <no-reply@example.com>"
RESEND_API_KEY=

# Optional. Google sign-in (leave both empty to hide the button).
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional. Cookie domain when the app is served from a subdomain behind a reverse proxy.
COOKIE_DOMAIN=
