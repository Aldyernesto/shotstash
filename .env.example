# Shotstash configuration.
# Generated from src/lib/config.ts by `npm run env:example`. Do not edit by hand.
#
# Copy this file to .env and fill in the secrets. Every value here is a
# placeholder; nothing in this file is a real secret. Empty means "not set".
# Full reference: docs/configuration.md
#
# docker compose: set SESSION_SECRET and POSTGRES_PASSWORD, then run
# `docker compose up -d`. The compose file sets DATABASE_URL, DRAGONFLY_HOST,
# STORAGE_LOCAL_ROOT and PORT for the app container itself.

# ----------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------

# development, production or test. The Docker image sets production; leave
# unset for local development.
# NODE_ENV=

# Port the server listens on inside the machine or container.
# Default: 3005.
PORT=3005

# Public URL of this installation (the address people open: LAN IP or domain),
# used in emails and share links. Defaults to http://localhost:<PORT> (with
# docker compose: http://localhost:<SHOTSTASH_PORT>). /api/health reports
# schemeMismatch when this says https but requests arrive as http.
APP_URL=

# Set to true ONLY when the app is reachable exclusively through a reverse
# proxy (Cloudflare, nginx) that sets cf-connecting-ip, x-forwarded-for and
# x-forwarded-proto. Otherwise clients could spoof those headers.
# Default: false.
TRUST_PROXY=

# fatal, error, warn, info, debug, trace or silent. Logs are JSON lines on
# stdout.
# Default: info.
LOG_LEVEL=info

# ----------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------

# PostgreSQL connection string. Local development: `npm run dev:db` starts an
# embedded PGlite server on port 55433. docker compose sets this for the app
# container itself.
# Required.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55433/postgres?sslmode=disable

# ----------------------------------------------------------------------
# Secrets
# ----------------------------------------------------------------------

# Signs sessions and password reset codes. At least 32 characters.
# Required. Secret: generate with `openssl rand -hex 32`.
SESSION_SECRET=

# Signs share media URLs, share access cookies and access codes. Falls back to
# SESSION_SECRET when empty.
# Secret: generate with `openssl rand -hex 32`.
MEDIA_SIGNING_SECRET=

# Recommended on any reachable host. While first-run setup is open, whoever
# submits /setup first becomes the super admin; with SETUP_TOKEN set the form
# requires it.
# Secret: generate with `openssl rand -hex 32`.
SETUP_TOKEN=

# ----------------------------------------------------------------------
# Storage
# ----------------------------------------------------------------------

# local (a directory, STORAGE_LOCAL_ROOT) or s3 (any S3-compatible bucket: AWS
# S3, Cloudflare R2, MinIO, RustFS, SeaweedFS). One backend per installation;
# switching later is a copy procedure (docs/storage.md).
# Default: local.
STORAGE_BACKEND=local

# local backend: directory for originals, thumbnails, covers and upload parts
# (any path, including a NAS mount). The Docker image uses /data/media.
# Default: ./data/media.
STORAGE_LOCAL_ROOT=./data/media

# s3 backend: endpoint URL, such as https://<account>.r2.cloudflarestorage.com
# or http://minio:9000. Empty for AWS S3.
S3_ENDPOINT=

# s3 backend: region. R2 uses auto; MinIO and RustFS accept us-east-1.
# Default: us-east-1.
S3_REGION=us-east-1

# s3 backend: bucket name (required with STORAGE_BACKEND=s3). Keep the bucket
# private.
S3_BUCKET=

# s3 backend: access key id (required with STORAGE_BACKEND=s3).
S3_ACCESS_KEY_ID=

# s3 backend: secret access key (required with STORAGE_BACKEND=s3).
# Secret.
S3_SECRET_ACCESS_KEY=

# s3 backend: true for servers that need path-style URLs (MinIO, RustFS,
# SeaweedFS); false for AWS S3 and R2.
# Default: false.
S3_FORCE_PATH_STYLE=false

# ----------------------------------------------------------------------
# Cache
# ----------------------------------------------------------------------

# Dragonfly (or Redis) host for realtime events, rate limits and locks. docker
# compose sets this for the app container.
# Default: 127.0.0.1.
DRAGONFLY_HOST=127.0.0.1

# Dragonfly port.
# Default: 6379.
DRAGONFLY_PORT=6379

# Dragonfly password, when the server requires one. docker compose ignores it
# (the bundled cache is reachable only on the compose network).
# Secret: generate with `openssl rand -hex 32`.
DRAGONFLY_PASSWORD=

# ----------------------------------------------------------------------
# Search
# ----------------------------------------------------------------------

# Optional. Elasticsearch accelerates search; leave empty to search in
# PostgreSQL only. With docker compose: `--profile search` and
# http://elasticsearch:9200.
ELASTICSEARCH_NODE_URL=

# ----------------------------------------------------------------------
# Sign-in
# ----------------------------------------------------------------------

# Public sign-up (new accounts wait for admin approval). Set to false to allow
# only admin-created accounts.
# Default: true.
SHOTSTASH_FEATURE_SIGNUP=true

# Optional. Google sign-in OAuth client id; leave empty to hide the button. A
# restart applies it, no rebuild.
GOOGLE_CLIENT_ID=

# ----------------------------------------------------------------------
# Email
# ----------------------------------------------------------------------

# Optional. Email for password reset. resend (or RESEND_API_KEY set): sent
# through Resend. log: nothing is sent, the last message is kept in memory
# (development and tests). Empty and no key: password reset stays hidden.
EMAIL_TRANSPORT=

# Sender address of outgoing email.
# Default: Shotstash <no-reply@example.com>.
EMAIL_FROM="Shotstash <no-reply@example.com>"

# Resend API key.
# Secret.
RESEND_API_KEY=

# ----------------------------------------------------------------------
# Product
# ----------------------------------------------------------------------

# Language for visitors and new accounts until they pick one. Unknown values
# fall back to en.
# Default: en.
SHOTSTASH_DEFAULT_LOCALE=en

# Time zone for server-written text (emails, share pages). Browsers show times
# in the viewer's own zone.
# Default: UTC.
SHOTSTASH_DEFAULT_TIMEZONE=UTC

# Days an item stays in the Trash before the hourly sweeper deletes it for
# good.
# Default: 30.
SHOTSTASH_TRASH_RETENTION_DAYS=30

# Set by the Docker image. Leave unset; the version in package.json is used
# otherwise.
# SHOTSTASH_VERSION=

# ----------------------------------------------------------------------
# Demo
# ----------------------------------------------------------------------

# Demo instances only. With true, `npm run demo:seed` (after first-run setup)
# creates read-only demo accounts and a sample project.
# Default: false.
SHOTSTASH_DEMO_MODE=

# Demo instances only. Password of every demo account, at least 10 characters.
# Secret.
DEMO_ADMIN_PASSWORD=

# ----------------------------------------------------------------------
# Docker Compose
# ----------------------------------------------------------------------

# docker compose only: password of the bundled PostgreSQL, fixed when the
# database is first created (changing it later breaks the connection).
# Letters, digits, - and _ only.
# Required. Secret: generate with `openssl rand -hex 32`.
POSTGRES_PASSWORD=

# docker compose only: host port published for the app. Change it when 3005 is
# taken.
# Default: 3005.
SHOTSTASH_PORT=3005
