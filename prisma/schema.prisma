// Shotstash database schema
// Engine: PostgreSQL 17

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ============================================
// ENUMS
// ============================================

enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum Role {
  SUPER_ADMIN
  ADMIN
  FIELD_CREW
  EDITOR
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DRAFT
}

enum ShareMode {
  PUBLIC
  PRIVATE
}

enum UploadStatus {
  IN_PROGRESS
  COMPLETING
  COMPLETED
  FAILED
  EXPIRED
}

// A file row exists from initiateUpload on (Story 4.3); only `ready` rows
// are part of the library. Every read of files filters status = ready.
enum MediaFileStatus {
  uploading
  ready
}

// ============================================
// MODELS
// ============================================

model User {
  id            String          @id @default(uuid())
  name          String
  email         String          @unique
  passwordHash  String?         // bcryptjs hash (nullable for Google-only users)
  googleId      String?         @unique
  role          Role            @default(EDITOR)
  active        Boolean         @default(true)
  accountStatus AccountStatus   @default(ACTIVE)  // ACTIVE utk user lama; signup baru -> PENDING
  requestedRole Role?                            // role yang DIMINTA saat onboarding (bukan hak)
  onboardedAt   DateTime?                        // kapan user isi onboarding
  approvedById  String?                          // admin yang approve
  approvedAt    DateTime?
  avatarUrl     String?
  signupAnswers Json?
  // UI locale (Story 3.1). Null = instance default (SHOTSTASH_DEFAULT_LOCALE, then en).
  locale        String?
  // Denies every write (demo and audit accounts). Reads still work.
  readOnly      Boolean         @default(false) @map("read_only")
  sessions      Session[]
  uploadedFiles MediaFile[]
  shareLinks    ShareLink[]
  uploadSessions UploadSession[]
  chats         ProjectChat[]
  notifications Notification[]
  passwordResetRequests PasswordResetRequest[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("users")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // upload_complete, chat_mention, file_shared, project_created
  title     String
  body      String
  data      Json?    // { projectId, fileId, chatId, etc }
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([token])
  @@map("sessions")
}

model Project {
  id          String        @id @default(uuid())
  title       String        // "Keberangkatan 12 Jan 2026"
  description String?
  coverImage  String?
  status      ProjectStatus @default(ACTIVE)
  files       MediaFile[]
  folders     Folder[]
  chats       ProjectChat[]
  shareLinks  ShareLink[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("projects")
}

model Folder {
  id        String      @id @default(uuid())
  name      String
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Folder?     @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]    @relation("FolderToFolder")
  files     MediaFile[]
  shareLinks ShareLink[]
  trashedAt DateTime?
  // Set on every descendant trashed together with a Section: the id of that
  // Section (the trash root). Null for a trash root and for live rows.
  trashRootId String?  @map("trash_root_id")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([projectId])
  @@index([parentId])
  @@index([trashedAt])
  @@index([trashRootId])
  @@map("folders")
}

model MediaFile {
  id            String       @id @default(uuid())
  filename      String       // Stored name: <id>.<ext> (display and legacy clients)
  originalName  String       // Name the uploader's file had
  mimeType      String       // Sniffed from the bytes at completion
  size          BigInt
  // MD5 of the uploaded bytes (empty until they were verified). After a
  // HEIC conversion it stays the MD5 of what the user uploaded (the dedup
  // key) until Story 4.4 keeps originals immutable. Dedup authority: a
  // partial unique index on (projectId, md5Checksum) over ready, untrashed
  // rows that are not marked duplicateOf (migration 0006).
  md5Checksum   String
  // Hierarchy-free key of the original (files/<id>/original.<ext>); set at
  // completion and never recomputed from names.
  storageKey    String       @map("storage_key")
  // 0 = no thumbnail; n = files/<id>/thumb-<n>.jpg exists.
  thumbVersion  Int          @default(0) @map("thumb_version")
  status        MediaFileStatus @default(ready)
  // Set when the uploader chose "Upload anyway" for identical bytes (or a
  // copy): the file this one duplicates. Such rows are outside the dedup index.
  duplicateOfId String?      @map("duplicate_of")
  duplicateOf   MediaFile?   @relation("MediaFileDuplicates", fields: [duplicateOfId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  duplicates    MediaFile[]  @relation("MediaFileDuplicates")
  folderId      String
  folder        Folder       @relation(fields: [folderId], references: [id], onDelete: Cascade)
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedById  String
  uploadedBy    User         @relation(fields: [uploadedById], references: [id])
  shareLinks    ShareLink[]
  chatMentions  ProjectChat[]
  uploadSessions UploadSession[]
  processedVersions ProcessedVersion[]
  trashedAt     DateTime?
  // See Folder.trashRootId.
  trashRootId   String?      @map("trash_root_id")
  createdAt     DateTime     @default(now())

  @@index([projectId, folderId])
  @@index([md5Checksum])
  @@index([trashedAt])
  @@index([trashRootId])
  @@index([status])
  @@map("media_files")
}

// Outputs derived from a file (Epic 5 pipeline). Created now and empty until
// the pipeline exists; purge deletes their keys with the file.
model ProcessedVersion {
  id          String    @id @default(uuid())
  mediaFileId String    @map("media_file_id")
  mediaFile   MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)
  kind        String
  jobId       String?   @map("job_id")
  attempt     Int       @default(1)
  storageKey  String    @map("storage_key")
  mimeType    String    @map("mime_type")
  size        BigInt
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([mediaFileId])
  @@map("processed_versions")
}

model ProjectChat {
  id               String      @id @default(uuid())
  message          String
  projectId        String
  project          Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  senderId         String
  sender           User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  referencedFileId String?
  referencedFile   MediaFile?  @relation(fields: [referencedFileId], references: [id], onDelete: SetNull)
  /// Null for a message a person wrote; "upload" for the system line added when a file finishes uploading.
  kind             String?
  createdAt        DateTime    @default(now())

  @@index([projectId])
  @@map("project_chats")
}

model ShareLink {
  id          String     @id @default(uuid())
  slug        String     @unique // nanoid(12) — URL-friendly
  mode        ShareMode
  fileId      String?
  file        MediaFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  folderId    String?
  folder      Folder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  projectId2  String?
  projectRef  Project?   @relation(fields: [projectId2], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  accessCount Int        @default(0)
  expiresAt   DateTime?
  // PRIVATE links: hash of the one-time access code (never the code itself).
  accessCodeHash String? @map("access_code_hash")
  // Soft revocation: the row stays so the page can answer "inactive".
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")
  createdAt   DateTime   @default(now())

  // A CHECK constraint (migration 0002) requires exactly one target unless the link is revoked.
  @@index([slug])
  @@map("share_links")
}

model UploadSession {
  id             String       @id @default(uuid())
  filename       String
  totalSize      BigInt
  totalChunks    Int          // number of parts
  partSize       Int          @map("part_size")
  md5Expected    String?      // Client MD5 of the whole file (at initiate or completion)
  // Opt-in "Upload anyway" for identical bytes already in the Project.
  allowDuplicate Boolean      @default(false) @map("allow_duplicate")
  projectId      String
  folderId       String
  uploadedById   String
  uploadedBy     User         @relation(fields: [uploadedById], references: [id])
  // The `uploading` file row this session fills (null once it is gone).
  mediaFileId    String?      @map("media_file_id")
  mediaFile      MediaFile?   @relation(fields: [mediaFileId], references: [id], onDelete: SetNull)
  // Opaque id of the storage backend's multipart upload.
  backendUploadId String?     @map("backend_upload_id")
  status         UploadStatus @default(IN_PROGRESS)
  // When the current completion claimed the session (status COMPLETING):
  // a retry may take over a claim older than 15 min, the sweeper ends one
  // older than 1 h.
  completingAt   DateTime?    @map("completing_at")
  parts          UploadPart[]
  createdAt      DateTime     @default(now())
  expiresAt      DateTime     // 24 h after initiate; the hourly sweeper expires it

  @@index([status, expiresAt])
  @@index([mediaFileId])
  @@map("upload_sessions")
}

// Confirmed parts of an upload session; a re-sent part replaces its row.
model UploadPart {
  sessionId  String        @map("session_id")
  session    UploadSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  partNumber Int           @map("part_number")
  size       Int
  etag       String
  md5        String
  createdAt  DateTime      @default(now()) @map("created_at")

  @@id([sessionId, partNumber])
  @@map("upload_parts")
}

// Reset password mandiri via email (kode OTP). Kode & token hanya disimpan sebagai hash.
// Baris dihapus semua saat reset sukses; baris lama dibatalkan saat kode baru dikirim.
model PasswordResetRequest {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash            String    // HMAC-SHA256 kode 6 karakter
  expiresAt           DateTime  // kode berlaku 15 menit; di-set ke masa lalu saat dibatalkan/terpakai
  attempts            Int       @default(0)
  resetTokenHash      String?   @unique // SHA-256 token reset (setelah kode benar)
  resetTokenExpiresAt DateTime? // token berlaku 10 menit, sekali pakai
  requestIp           String?
  createdAt           DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("password_reset_requests")
}

// First-run setup (Story 2.6): a single row (id = 1, enforced by a CHECK in
// migration 0003). While it is missing the app only serves /setup.
model InstanceSetting {
  id               Int      @id @default(1)
  setupCompletedAt DateTime @map("setup_completed_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("instance_settings")
}
